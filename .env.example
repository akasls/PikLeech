# PikPak 多账号聚合网盘 Web 系统配置文件
# 复制本文件为 .env 并修改以下配置

# 服务监听端口 (默认 8080)
PORT=8080

# 数据持久化目录 (Docker 内部为 /data)
DATA_DIR=./data

# 应用全局高强度密钥 (用于 AES-256-GCM 加密数据库中的账号密码、Token、Cookie签名)
# 强烈建议在生产环境设置为随机生成的 32 位以上字符串
APP_SECRET=pikpak-super-secret-encryption-key-32chars!

# 初次启动时的默认管理员账号
ADMIN_USERNAME=admin

# 初次启动时的默认管理员密码 (初始化后以 bcrypt 安全哈希保存，不可逆)
ADMIN_PASSWORD=admin123456

# 日志输出级别 (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
